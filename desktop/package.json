{
  "name": "offerpath-desktop",
  "productName": "OfferPath",
  "version": "1.1.1",
  "description": "OfferPath desktop app: opens the OfferPath web workspace in its own window.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "bid.offerpath.desktop",
    "productName": "OfferPath",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "badge.js", "preload.js", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OfferPath"
    }
  }
}
